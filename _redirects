# WordPress → Ny Cloudflare Pages (permanent redirects)
# NB: Cloudflare Pages strips trailing slashes BEFORE _redirects are evaluated.
#     Also, pretty URLs auto-serve .html files, so paths with matching files
#     don't need redirects (bli-kunde, personvern, om-oss serve directly).

# Pages that DON'T have matching .html files — must redirect
/vilkar-betingelser   /vilkar                 301
/kundeservice         /kontakt                301
/min-konto            /kundeportal            301
/kontakt-oss          /kontakt                301

# WooCommerce redirects (shop pages → produkter)
/shop                 /produkter              301
/produkt/*            /produkter              301
/kategori/*           /produkter              301
/sidekurv             /produkter              301
/kasse                /produkter              301

# API passthrough
/api/*                https://autoglass-glass-sok.autoglassnorge.workers.dev/api/:splat 200
