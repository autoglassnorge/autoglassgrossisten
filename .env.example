# Biluppgifter API (Swedish vehicle lookup)
BILUPPGIFTER_API_KEY=your_api_key_here

# Cloudflare (KV + Worker deploy)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_api_token
GLASS_KV_NAMESPACE_ID=your_kv_namespace_id

# Supabase (kundeportal auth — optional)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

# UNI Micro (future: OAuth for catalog export)
# UNI_MICRO_CLIENT_ID=xxx
# UNI_MICRO_CLIENT_SECRET=xxx
# UNI_MICRO_REDIRECT_URI=xxx
